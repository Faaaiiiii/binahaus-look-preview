{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "A house at dusk, lit from inside. The owner's navy as the ground, his gold as the single lit line, his own photographs and words carrying the work.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.059,
          0.086,
          0.149
        ],
        "hex": "#0f1626"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.122,
          0.165,
          0.267
        ],
        "hex": "#1f2a44"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.776,
          0.655,
          0.369
        ],
        "hex": "#c6a75e"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.98,
          0.973,
          0.957
        ],
        "hex": "#faf8f4"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.91,
          0.863,
          0.784
        ],
        "hex": "#e8dcc8"
      }
    },
    "body-text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.745,
          0.714,
          0.663
        ],
        "hex": "#beb6a9"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "section": {
      "$value": {
        "value": 72,
        "unit": "px"
      }
    },
    "gutter": {
      "$value": {
        "value": 56,
        "unit": "px"
      }
    },
    "block": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "row": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "inline": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display-1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo",
        "fontSize": {
          "value": 4.6,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "display-2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo",
        "fontSize": {
          "value": 2.9,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "heading-3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo",
        "fontSize": {
          "value": 1.75,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontSize": {
          "value": 1.19,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label-caps": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo",
        "fontSize": {
          "value": 0.8,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.16,
          "unit": "em"
        }
      }
    },
    "nav-link": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontSize": {
          "value": 0.92,
          "unit": "rem"
        },
        "fontWeight": 500
      }
    }
  }
}
