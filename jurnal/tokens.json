{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Daylight on the owner's sand. Five steps as the spine, his own photographs hanging off them, each labelled by what it actually shows.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.91,
          0.863,
          0.784
        ],
        "hex": "#e8dcc8"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.98,
          0.973,
          0.957
        ],
        "hex": "#faf8f4"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.059,
          0.086,
          0.149
        ],
        "hex": "#0f1626"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.776,
          0.655,
          0.369
        ],
        "hex": "#c6a75e"
      }
    },
    "accent-ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4,
          0.365,
          0.294
        ],
        "hex": "#665d4b"
      }
    },
    "surface-deep": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.122,
          0.165,
          0.267
        ],
        "hex": "#1f2a44"
      }
    },
    "muted-ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.224,
          0.259,
          0.333
        ],
        "hex": "#394255"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "section": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    },
    "gutter": {
      "$value": {
        "value": 56,
        "unit": "px"
      }
    },
    "block": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "row": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "inline": {
      "$value": {
        "value": 9,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display-1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Schibsted Grotesk",
        "fontSize": {
          "value": 2.7,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.008,
          "unit": "em"
        }
      }
    },
    "display-2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Schibsted Grotesk",
        "fontSize": {
          "value": 2.7,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "heading-2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Schibsted Grotesk",
        "fontSize": {
          "value": 1.7,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Source Sans 3",
        "fontSize": {
          "value": 1.2,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Source Sans 3",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Schibsted Grotesk",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "numeral": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Schibsted Grotesk",
        "fontSize": {
          "value": 1.2,
          "unit": "rem"
        },
        "fontWeight": 700
      }
    }
  }
}
